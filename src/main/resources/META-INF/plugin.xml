<idea-plugin>
    <id>dev.jpm</id>
    <name>jpm</name>
    <vendor url="https://github.com/java-package-manager/jpm">jpm</vendor>
    <description><![CDATA[
    Support for <a href="https://github.com/java-package-manager/jpm">jpm</a>, the Java package manager and build tool.
    <ul>
      <li>Opens jpm projects (<code>project.jsonc</code>) and sets them up: modules, source and test folders,
          dependencies with sources, and the JDK the project asks for, installed by jpm when missing.</li>
      <li>Completion, documentation and validation in <code>project.jsonc</code>, from the JSON Schema of the installed jpm.</li>
      <li>Finds jpm projects in nested folders too, and loads each of them.</li>
      <li>Reloads by itself when <code>project.jsonc</code> or <code>project.lock</code> change.</li>
      <li>A jpm tool window with the project's tasks and scripts: build, test, start, dev, publish and more.</li>
      <li>Moves Maven and Gradle projects to jpm with <code>jpm import</code>: review and edit the manifests first, switch to jpm's layout, delete the old build, and find what still uses Gradle or Maven.</li>
      <li>Creates jpm projects and modules: jpm is a build system in the Java New Project and New Module wizards, and new modules join the jpm workspace they are created in.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.json</depends>

    <resource-bundle>messages.JpmBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="jpm" displayType="BALLOON" bundle="messages.JpmBundle" key="notification.group"/>

        <applicationService serviceImplementation="dev.jpm.intellij.JpmSettings"/>
        <applicationConfigurable parentId="build.tools" instance="dev.jpm.intellij.JpmConfigurable"
                                 id="dev.jpm.intellij.settings" displayName="jpm"/>

        <postStartupActivity implementation="dev.jpm.intellij.JpmStartup"/>
        <projectOpenProcessor implementation="dev.jpm.intellij.JpmProjectOpenProcessor"/>
        <newProjectWizard.generator implementation="dev.jpm.intellij.JpmNewProjectWizard"/>
        <newProjectWizard.java.buildSystem implementation="dev.jpm.intellij.JpmBuildSystemWizard"/>

        <toolWindow id="jpm" anchor="right" icon="dev.jpm.intellij.JpmIcons.ToolWindow"
                    factoryClass="dev.jpm.intellij.JpmToolWindowFactory"/>

        <configurationType implementation="dev.jpm.intellij.JpmConfigurationType"/>

        <psi.referenceContributor language="JSON" implementation="dev.jpm.intellij.JpmManifestReferenceContributor"/>
        <referencesSearch implementation="dev.jpm.intellij.JpmManifestReferencesSearcher"/>
    </extensions>

    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="dev.jpm.intellij.JpmSchemaProviderFactory"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.jpm.intellij.JpmUnloader" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="dev.jpm.intellij.JpmFileListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="Jpm.Reload" class="dev.jpm.intellij.ReloadAction" icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="Jpm.Migrate" class="dev.jpm.intellij.MigrateAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
